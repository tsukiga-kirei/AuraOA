# =============================================================================
# Nuxt 前端环境变量（复制为 frontend/.env 后修改）
# =============================================================================
# 本地开发：cd frontend && npm run dev
# Nuxt 只读取本目录下的 .env，不会自动加载项目根目录 .env
# EMBED_* 须与根目录 .env 中 Go 侧配置保持一致
# =============================================================================

NUXT_PUBLIC_API_BASE=http://localhost:8080
NUXT_PUBLIC_MOCK_MODE=false

# OA 嵌入审核（仅 /embed/audit 页面与 /api/embed/* 代理使用）
# 不配置时嵌入页会 503；不影响 dashboard 等需 JWT 登录的页面
EMBED_ACCESS_TOKEN=changeme_embed_token_use_random_string_in_prod
EMBED_TENANT_CODE=your_tenant_code
