# =============================================================================
# Nuxt 前端环境变量（复制为 frontend/.env 后修改）
# =============================================================================
# 本地开发：cd frontend && npm run dev
# Nuxt 只读取本目录下的 .env，不会自动加载项目根目录 .env
# OA 嵌入密钥在「系统管理 → 租户管理 → OA 嵌入」中按租户生成，不再使用全局 EMBED_* 环境变量
# =============================================================================

NUXT_PUBLIC_API_BASE=http://localhost:8080
# Nuxt 服务端代理访问 Go 的地址；本地开发可与公开 API 地址相同。
NUXT_INTERNAL_API_BASE=http://localhost:8080
# 前端日期展示统一时区；Docker 部署时由根目录 APP_TIMEZONE 注入。
NUXT_PUBLIC_TIME_ZONE=Asia/Shanghai
